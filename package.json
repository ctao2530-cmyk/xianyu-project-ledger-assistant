{
  "name": "xianyu-dev-operator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": ".venv/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8877 --reload",
    "dev:local": ".venv/bin/python scripts/integration/start_local.py --dev",
    "local": ".venv/bin/python scripts/integration/start_local.py",
    "db:migrate": ".venv/bin/python scripts/integration/migrate.py",
    "xianyu:configure": ".venv/bin/python scripts/configure_xianyu.py",
    "test:backend": ".venv/bin/python -m pytest backend/tests",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:interactions": "node --test tests/project-cockpit-interactions.test.mjs tests/xunying-decision-workbench.test.mjs tests/business-analysis-center.test.mjs tests/requirement-export-workbench.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.3.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
