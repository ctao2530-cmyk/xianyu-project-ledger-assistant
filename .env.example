# Local-only unified service. Copy to .env and fill secrets locally.
APP_HOST=127.0.0.1
APP_PORT=8877
DATABASE_URL=sqlite:///./data/xianyu_operator.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Xianyu credentials must never be committed.
XIANYU_COOKIE=
# Optional. Leave empty unless you explicitly accept a local mode-0600 cache
# for the two short-lived MTop refresh cookies.
XIANYU_SESSION_CACHE_PATH=
# Disabled by default so stale desktop proxy variables cannot break Xianyu.
XIANYU_USE_SYSTEM_PROXY=false

# Read-only product monitoring. One remote collection per local calendar day.
PRODUCT_COLLECTION_ENABLED=true
PRODUCT_COLLECTION_HOUR=8
PRODUCT_COLLECTION_MINUTE=30
PRODUCT_COLLECTION_TIMEZONE=Asia/Shanghai
PRODUCT_COLLECTION_CHECK_INTERVAL_SECONDS=1800
PRODUCT_COLLECTION_REQUEST_DELAY_SECONDS=2.5
PRODUCT_COLLECTION_MAX_ITEMS=100
PRODUCT_DELIVERY_CAPACITY=4
# Advisory multi-product exposure plan. The app never purchases traffic.
PRODUCT_TRAFFIC_BATCH_COST=5.9
PRODUCT_TRAFFIC_WEEKLY_BUDGET=24
PRODUCT_TRAFFIC_BATCH_MIN_ITEMS=3
PRODUCT_TRAFFIC_BATCH_MAX_ITEMS=5
PRODUCT_TRAFFIC_COOLDOWN_HOURS=72
PRODUCT_TRAFFIC_REMINDER_MINUTES=30
PRODUCT_TRAFFIC_BASELINE_MAX_AGE_MINUTES=30
PRODUCT_MARKET_REMINDER_HOUR=20
PRODUCT_MARKET_REMINDER_MINUTE=0
PRODUCT_MODIFICATION_OBSERVATION_DAYS=7

AI_PROVIDER=codex_cli
CODEX_COMMAND=/Applications/ChatGPT.app/Contents/Resources/codex
XUNYING_CODEX_EVENT_SECRET=
XUNYING_CODEX_API_BASE=http://127.0.0.1:8877
# XUNYING_CODEX_WORKTREE_ROOT=/Users/yourname/Library/Application Support/循营/codex-worktrees
CODEX_TIMEOUT_SECONDS=300
CODEX_MAX_CONCURRENCY=2
CODEX_IGNORE_USER_CONFIG=true
CODEX_IGNORE_RULES=true

REPLY_SPEED_MODE=balanced
REQUIREMENT_ANALYSIS_MODEL=gpt-5.6-sol
REQUIREMENT_ANALYSIS_REASONING_EFFORT=max

# Fast reply drafts and read-only lead analysis. Keep this key only in .env.
CUSTOMER_REPLY_DRAFTS_ENABLED=false
CUSTOMER_QUOTE_CONVERSION_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REPLY_MODEL=deepseek-v4-flash
DEEPSEEK_LEAD_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=12

# Independent read-only sales analysis. Business writes still require a click.
SALES_AGENT_ENABLED=true
SALES_AGENT_AUTO_ANALYZE=true
SALES_AGENT_TIMEOUT_SECONDS=15
SALES_AGENT_HISTORY_LIMIT=30

WECHAT_PROVIDER=mock
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=

# ChatGPT remote MCP authentication. Use an external OAuth 2.1/OIDC provider
# such as Auth0; keep real issuer subjects and client identifiers only in .env.
CUSTOMER_CONTEXT_OAUTH_ENABLED=false
CUSTOMER_CONTEXT_OAUTH_ISSUER_URL=
CUSTOMER_CONTEXT_OAUTH_AUDIENCE=
CUSTOMER_CONTEXT_OAUTH_RESOURCE_SERVER_URL=
CUSTOMER_CONTEXT_OAUTH_JWKS_URL=
CUSTOMER_CONTEXT_OAUTH_REQUIRED_SCOPE=customer-context.read
CUSTOMER_CONTEXT_OAUTH_ALLOWED_SUBJECTS=
CUSTOMER_CONTEXT_OAUTH_ALLOWED_CLIENT_IDS=

# Single-user Secure MCP Tunnel mode for this local deployment. Set the mode to
# tunnel_binding locally, but keep the secret outside this file and inject it
# from macOS Keychain into both the backend and tunnel-client processes.
CUSTOMER_CONTEXT_MCP_AUTH_MODE=oauth
CUSTOMER_CONTEXT_TUNNEL_SECRET=

# Human confirmation is the default. This only enables the optional timed switch.
AUTO_REPLY_FEATURE_ENABLED=true
MACOS_NOTIFICATIONS=false

# Local OpenAI incremental-analysis admission controls (not a currency budget).
CUSTOMER_ANALYSIS_DAILY_RUN_LIMIT=100
CUSTOMER_ANALYSIS_MAX_OUTPUT_TOKENS=12000
