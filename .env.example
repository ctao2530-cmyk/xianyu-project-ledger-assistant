# Local-only unified service. Copy to .env and fill secrets locally.
APP_HOST=127.0.0.1
APP_PORT=8877
DATABASE_URL=sqlite:///./data/xianyu_operator.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Xianyu credentials must never be committed.
XIANYU_COOKIE=
# Disabled by default so stale desktop proxy variables cannot break Xianyu.
XIANYU_USE_SYSTEM_PROXY=false

# Read-only product monitoring. One remote collection per local calendar day.
PRODUCT_COLLECTION_ENABLED=true
PRODUCT_COLLECTION_HOUR=8
PRODUCT_COLLECTION_MINUTE=30
PRODUCT_COLLECTION_TIMEZONE=Asia/Shanghai
PRODUCT_COLLECTION_CHECK_INTERVAL_SECONDS=1800
PRODUCT_COLLECTION_REQUEST_DELAY_SECONDS=0.8
PRODUCT_COLLECTION_MAX_ITEMS=100
PRODUCT_DELIVERY_CAPACITY=4

AI_PROVIDER=codex_cli
CODEX_COMMAND=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_TIMEOUT_SECONDS=120
CODEX_MAX_CONCURRENCY=2
CODEX_IGNORE_USER_CONFIG=true
CODEX_IGNORE_RULES=true

REPLY_SPEED_MODE=balanced
REQUIREMENT_ANALYSIS_MODEL=gpt-5.6-sol
REQUIREMENT_ANALYSIS_REASONING_EFFORT=max

# Fast reply drafts and read-only lead analysis. Keep this key only in .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REPLY_MODEL=deepseek-v4-flash
DEEPSEEK_LEAD_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=12

WECHAT_PROVIDER=mock
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=

# Human confirmation is the default. This only enables the optional timed switch.
AUTO_REPLY_FEATURE_ENABLED=true
MACOS_NOTIFICATIONS=false
